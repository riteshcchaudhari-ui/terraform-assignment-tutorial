# Local .terraform directories
**/.terraform/*

# Terraform lock file (optional to commit, many teams do commit this)
# .terraform.lock.hcl

# Crash log files
crash.log
crash.*.log

# State files — NEVER commit, contain secrets
*.tfstate
*.tfstate.*

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
